{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "SecretManager": {
    "VaultUrl": ""
  },
  "Schedule": {
    "SyncLogins": "30 1 * * *"
  },
  "UploadTo": {
  },
  "ConnectionStrings": {
    "HangfireConnection": ""
  }
}
