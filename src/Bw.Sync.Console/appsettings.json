{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "Properties": {
      "Application": "BwSync"
    }
  },
    "UploadTo": {
      "Type": "File",
      "BasePath": "./output"
    },
  "ApiKeys": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "HashPepper": ""
}
