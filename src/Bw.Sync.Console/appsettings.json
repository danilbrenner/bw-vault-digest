{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "Properties": {
      "Application": "BwSync"
    }
  },
//  "UploadTo": {
//    "Type": "AzureBlob",
//    "ConnectionString": "",
//    "ContainerName": ""
//  },
  "UploadTo": {
    "Type": "File",
    "BasePath": "./output"
  },
  "ApiKeys": {
    "ClientId": "",
    "ClientSecret": ""
  }
}
